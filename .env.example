# siem-home-lab :: configuration template
#
#   cp .env.example .env    then fill in the values you have.
#
# Every integration degrades gracefully: leave a value as REPLACE_ME and
# scripts/render_config.py simply omits that integration rather than shipping
# a broken one. Nothing here is required to bring the stack up.

# --- Wazuh stack credentials (used by docker-compose) ----------------------
# CHANGE THESE. The upstream defaults are public knowledge.
INDEXER_USERNAME=admin
INDEXER_PASSWORD=REPLACE_ME
API_USERNAME=wazuh-wui
API_PASSWORD=REPLACE_ME
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=REPLACE_ME

# Wazuh cluster key. This authenticates cluster nodes and IS a credential.
# Generate your own:  openssl rand -hex 16
CLUSTER_KEY=REPLACE_ME

# --- Alerting -------------------------------------------------------------
# Slack incoming webhook. Alerts at level 10+ are posted; level 12+ are
# escalated with a channel mention. See docs/03-integrations.md.
SLACK_WEBHOOK_URL=REPLACE_ME

# n8n webhook for lower-severity automation (level 3+).
N8N_WEBHOOK_URL=REPLACE_ME

# --- Threat intelligence --------------------------------------------------
# VirusTotal free tier: 4 requests/minute, 500/day. https://virustotal.com
VIRUSTOTAL_API_KEY=REPLACE_ME

# AlienVault OTX, free. https://otx.alienvault.com
OTX_API_KEY=REPLACE_ME

# abuse.ch (ThreatFox + URLhaus) now require an Auth-Key. Free at
# https://auth.abuse.ch/ - without it those two sources report "skipped".
ABUSECH_AUTH_KEY=REPLACE_ME

# --- Misc -----------------------------------------------------------------
WAZUH_DASHBOARD_URL=https://localhost
